/**
 * Implements hook_page_build().
 */
function campaignion_tracking_ga4_page_build(&$page) {
  $module_path = drupal_get_path('module', 'campaignion_tracking_ga4');

  // Add javascript.
  $page['content']['#attached']['js'][$module_path . '/js/campaignion_tracking_ga4.min.js'] = [
    'scope' => 'header',
    'group' => JS_LIBRARY - 100,
    'preprocess' => FALSE,
  ];
}

/**
 * Implements hook_campaignion_tracking_snippets().
 */
function campaignion_tracking_ga4_campaignion_tracking_snippets() {
  if ($tag_id = variable_get('campaignion_tracking_ga4_id')) {
    $exports['ga4'] = <<<SCRIPT
      var script = document.createElement("script");
      script.async = true;
      script.src = "https://www.googletagmanager.com/gtag/js?id=$tag_id";
      var nonce = document.querySelector('[nonce]')?.nonce;
      nonce && script.setAttribute('nonce', nonce);
      document.head.appendChild(script);
      window.dataLayer = window.dataLayer || [];
      function gtag () { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', '$tag_id');
      SCRIPT;
    return $exports;
  }
}

/**
 * Implements hook_d7csp_hosts().
 */
function campaignion_tracking_ga4_d7csp_hosts() {
  $domain_hosts = array_map(function ($domain) {
    return "https://*$domain";
  }, explode(' ', GA4_DOMAINS));
  $common_hosts = [
    'https://*.google-analytics.com',
    'https://*.googletagmanager.com',
    'https://*.analytics.google.com',
    'https://*.g.doubleclick.net',
    'https://*.google.com',
    'https://google.com',
    'https://googleads.g.doubleclick.net',
    'https://pagead2.googlesyndication.com',
    'https://www.googleadservices.com'
  ];
  $hosts['script-src'] = [
    'https://*.googletagmanager.com',
    'https://www.googleadservices.com',
    'https://www.google.com',
    'https://pagead2.googlesyndication.com',
    'https://googleads.g.doubleclick.net'
  ];
  $hosts['img-src'] = array_merge($common_hosts, $domain_hosts);
  $hosts['connect-src'] = array_merge($common_hosts, $domain_hosts);
  $hosts['frame-src'] = [
    'https://td.doubleclick.net',
    'https://www.googletagmanager.com'
  ];
  return $hosts;
}
